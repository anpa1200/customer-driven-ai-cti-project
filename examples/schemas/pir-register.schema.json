{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1200km.com/customer-driven-ai-cti-project/schemas/pir-register.schema.json",
  "title": "PIR Register Row",
  "type": "object",
  "required": [
    "pir_id",
    "decision_owner",
    "decision",
    "question",
    "time_horizon",
    "status",
    "confidence_threshold"
  ],
  "properties": {
    "pir_id": {"type": "string", "pattern": "^PIR-[0-9]{3}$"},
    "decision_owner": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "time_horizon": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["Draft", "Approved", "Closed", "Deferred"]},
    "confidence_threshold": {"type": "string", "enum": ["Low", "Moderate", "High"]}
  }
}
