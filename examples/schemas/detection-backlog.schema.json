{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1200km.com/customer-driven-ai-cti-project/schemas/detection-backlog.schema.json",
  "title": "Detection Backlog Row",
  "type": "object",
  "required": [
    "detection_id",
    "title",
    "scenario_id",
    "technique",
    "data_source",
    "drl",
    "status",
    "owner",
    "priority"
  ],
  "properties": {
    "detection_id": {"type": "string", "pattern": "^DET-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "pattern": "^SCN-[0-9]{3}$"},
    "technique": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
    "data_source": {"type": "string", "minLength": 1},
    "drl": {"type": "integer", "minimum": 0, "maximum": 9},
    "status": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "enum": ["Low", "Medium", "High", "Critical"]}
  }
}
