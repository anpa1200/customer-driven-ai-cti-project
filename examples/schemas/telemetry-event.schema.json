{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1200km.com/customer-driven-ai-cti-project/schemas/telemetry-event.schema.json",
  "title": "Synthetic Cloud Identity Telemetry Event",
  "type": "object",
  "required": [
    "event_time_utc",
    "event_source",
    "user",
    "src_ip",
    "operation",
    "target",
    "result",
    "correlation_id"
  ],
  "properties": {
    "event_time_utc": {"type": "string", "format": "date-time"},
    "event_source": {"type": "string", "enum": ["EntraIDSignin", "EntraIDAudit", "AzureActivity"]},
    "user": {"type": "string", "minLength": 1},
    "src_ip": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "result": {"type": "string", "enum": ["Success", "Failed"]},
    "correlation_id": {"type": "string", "pattern": "^CORR-[0-9]{4}$"}
  }
}
